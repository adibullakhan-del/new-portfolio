    box-shadow: 0 0 25px rgba(255,255,255,.25);
}

.road::after {
    content: "";
    position: absolute;
    left: 0;
    top: -20px;
    width: 100%;
    height: 2px;
    background: repeating-linear-gradient(
        90deg,
        transparent 0 30px,
        rgba(255,255,255,.4) 30px 80px
